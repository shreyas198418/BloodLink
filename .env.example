# GEMINI_API_KEY: Optional for AI enhancements.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC signing secret for local staff/admin auth cookies & tokens.
SESSION_SECRET="change-me-in-local-development"

# Cloud SQL PostgreSQL connection variables (injected by Cloud SQL Auth Proxy / runtime)
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="bloodlink"
SQL_USER="app_user"
SQL_PASSWORD="app_user_password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="admin_password"
